    "home.empty.message" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie haben noch keine Drehbücher.\nBeginnen Sie Ihren ersten Entwurf, um ihn zum Leben zu erwecken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You don't have any screenplays yet.\nStart your first draft to bring it to life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no tienes ningún guion.\nEmpieza tu primer borrador para darle vida."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous n’avez encore aucun scénario.\nCommencez votre premier brouillon pour lui donner vie."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आपके पास अभी तक कोई पटकथा नहीं है।\nइसे जीवंत करने के लिए अपना पहला ड्राफ़्ट शुरू करें।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "まだ脚本がありません。\n最初の下書きを始めて形にしましょう。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아직 시나리오가 없습니다.\n첫 초안을 시작해 이야기를 살려 보세요."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你还没有任何剧本。\n开始你的第一份草稿，让它活起来。"
          }
        }
      }
    },
