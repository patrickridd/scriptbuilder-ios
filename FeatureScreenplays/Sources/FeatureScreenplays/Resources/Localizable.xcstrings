    "identity.ui.arc.none.subtitle" : {
      "extractionState" : "stale",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objekte, Kräfte und Figuren, die nie etwas wollen – markiere es, und der Bogen gilt als fertig."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objects, forces and figures who never want anything — mark it and the arc counts as done."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetos, fuerzas y figuras que nunca quieren nada: márcalo y el arco contará como completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objets, forces et figures qui ne veulent jamais rien — cochez et l'arc est considéré comme terminé."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "वस्तुएँ, शक्तियाँ और ऐसे पात्र जो कभी कुछ नहीं चाहते — इसे चिह्नित करें और आर्क पूर्ण मान लिया जाएगा।"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "何も望まない物体・力・存在。設定すればアークは完了として扱われます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 원하지 않는 사물, 힘, 존재. 표시하면 아크가 완료로 간주됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从不渴求任何东西的物件、力量与存在——标记后弧线即视为完成。"
          }
        }
      }
    },
